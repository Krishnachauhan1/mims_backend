APP_NAME="Power Force Industries"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://powerforceindustries.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u683672103_mims
DB_USERNAME=u683672103_mims
DB_PASSWORD=your_database_password_from_hpanel

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=powerforceindustries.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

SANCTUM_STATEFUL_DOMAINS=powerforceindustries.com,www.powerforceindustries.com
# Flutter web: mims.powerforceindustries.com → API: powerforceindustries.com/api
CORS_ALLOWED_ORIGINS=https://mims.powerforceindustries.com,https://powerforceindustries.com

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@powerforceindustries.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
